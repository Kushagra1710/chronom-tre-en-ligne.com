---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import "../styles/tools.css";
import { SITE_URL } from "../lib/site";
import Icon from "../components/Icon.astro";
interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}
const {
  title = "Chronomètre en ligne gratuit avec tours et plein écran",
  description = "Chronomètre en ligne gratuit : mesurez le temps, enregistrez vos tours et passez en plein écran. Pour la classe, le sport et les études, sans inscription.",
  image = "/web-app-manifest-512x512.png",
  noindex = false,
} = Astro.props;
const canonicalPath =
  Astro.url.pathname === "/"
    ? "/"
    : `${Astro.url.pathname.replace(/\/+$/, "")}/`;
const canonical = new URL(canonicalPath, SITE_URL);
const socialImage = new URL(image, canonical).toString();
---

<!doctype html>
<html lang="fr">
  <head>
    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-40ZNFZXB6W"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-40ZNFZXB6W");
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafafa" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {!noindex && <link rel="alternate" hreflang="fr" href={canonical} />}
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Chronomètre" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Chronomètre en ligne" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta
      property="og:image:alt"
      content="Chronomètre en ligne gratuit avec affichage du temps"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta
      name="twitter:image:alt"
      content="Chronomètre en ligne gratuit avec affichage du temps"
    />
    <title>{title}</title>
    <script is:inline>
      try {
        const choice = localStorage.getItem("rs-theme") || "system";
        const dark =
          choice === "dark" ||
          (choice === "system" &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
        document.querySelector('meta[name="theme-color"]').content = dark
          ? "#111111"
          : "#fafafa";
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Aller au contenu
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a
          href="/"
          class="wordmark"
          aria-label="Accueil du chronomètre en ligne"
        >
          <span class="brand-icon">
            <Icon name="watch" size={22} />
          </span>
          <span translate="no">
            chrono<span class="wordmark-secondary">mètre en ligne</span>
            <span class="brand-period">.</span>
          </span>
        </a>
        <nav aria-label="Navigation principale" class="desktop-navigation">
          <details class="tools-dropdown">
            <summary>
              Tous les outils
              <Icon name="arrow" size={14} />
            </summary>
            <div class="tools-dropdown-panel">
              <a href="/outils/">Tous les outils</a>
              <details>
                <summary>
                  Chronomètres
                  <Icon name="arrow" size={13} />
                </summary>
                <div class="tools-submenu">
                  <a href="/">Chronomètre numérique</a>
                  <a href="/chronometre-analogique/">Chronomètre analogique</a>
                  <a href="/chronometre-minimaliste/">
                    Chronomètre minimaliste
                  </a>
                  <a href="/chronometre-personnalise/">
                    Chronomètre personnalisé
                  </a>
                </div>
              </details>
              <details>
                <summary>
                  Minuteurs
                  <Icon name="arrow" size={13} />
                </summary>
                <div class="tools-submenu">
                  <a href="/minuteur/">Minuteur en ligne</a>
                  <a href="/pomodoro/">Minuteur Pomodoro</a>
                  <a href="/minuteur-intervalle/">Minuteur à intervalles</a>
                </div>
              </details>
            </div>
          </details>
          <a href="/a-propos/" class="header-page-link">
            À propos
          </a>
          <a href="/confidentialite/" class="header-page-link">
            Confidentialité
          </a>
          <a href="/conditions-utilisation/" class="header-page-link">
            Conditions d’utilisation
          </a>
          <a href="/contact/" class="header-page-link">
            Contact
          </a>
        </nav>
        <button
          class="icon-button theme-toggle"
          aria-label="Changer de thème"
          title="Changer de thème"
        >
          <Icon name="sun" />
          <span class="sr-only">Changer de thème</span>
        </button>
      </div>
    </header>
    <slot />
    <footer class="site-footer wrap">
      <div>
        <a href="/" class="wordmark footer-brand">
          <Icon name="watch" size={20} />
          <span translate="no">
            chronomètre <span class="wordmark-secondary">en ligne</span>.
          </span>
        </a>
        <p>Un espace pour mesurer votre temps.</p>
      </div>
      <nav aria-label="Navigation de pied de page">
        <a href="/a-propos/">À propos</a>
        <a href="/confidentialite/">Confidentialité</a>
        <a href="/conditions-utilisation/">Conditions d’utilisation</a>
        <a href="/contact/">Contact</a>
        <a href="/#questions">Aide</a>
      </nav>
      <span class="footer-domain">
        chronomètre-en-ligne.com <span aria-hidden="true">↗</span>
      </span>
    </footer>
    <script>
      const media = matchMedia("(prefers-color-scheme: dark)");
      function applyTheme(choice: string) {
        const dark =
          choice === "dark" || (choice === "system" && media.matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
        document.querySelector<HTMLMetaElement>(
          'meta[name="theme-color"]',
        )!.content = dark ? "#111111" : "#fafafa";
        document
          .querySelector(".theme-toggle")
          ?.setAttribute(
            "aria-label",
            `Passer au thème ${dark ? "clair" : "sombre"}`,
          );
        const select =
          document.querySelector<HTMLSelectElement>("#theme-choice");
        if (select) select.value = choice;
      }
      function choice() {
        try {
          return localStorage.getItem("rs-theme") || "system";
        } catch {
          return "system";
        }
      }
      function setTheme(value: string) {
        try {
          localStorage.setItem("rs-theme", value);
        } catch {}
        applyTheme(value);
      }
      applyTheme(choice());
      document
        .querySelector(".theme-toggle")
        ?.addEventListener("click", () =>
          setTheme(
            document.documentElement.dataset.theme === "dark"
              ? "light"
              : "dark",
          ),
        );
      document
        .querySelector("#theme-choice")
        ?.addEventListener("change", (event) =>
          setTheme((event.target as HTMLSelectElement).value),
        );
      media.addEventListener("change", () => {
        if (choice() === "system") applyTheme("system");
      });
    </script>
  </body>
</html>
