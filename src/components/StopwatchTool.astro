---
import Icon from "./Icon.astro";
import type { StopwatchVariant } from "../lib/tools";
import CustomControls from "./CustomControls.astro";
interface Props {
  variant?: StopwatchVariant;
}
const { variant = "digital" } = Astro.props;
const label = {
  digital: "Chronomètre",
  analog: "Chronomètre analogique",
  minimal: "Chronomètre minimaliste",
  custom: "Chronomètre personnalisé",
}[variant];
const stopwatchTypes = [
  { variant: "digital", label: "Numérique", href: "/" },
  { variant: "analog", label: "Analogique", href: "/chronometre-analogique/" },
  {
    variant: "minimal",
    label: "Minimaliste",
    href: "/chronometre-minimaliste/",
  },
  {
    variant: "custom",
    label: "Personnalisé",
    href: "/chronometre-personnalise/",
  },
] as const;
---

<div class="workspace wrap" data-stopwatch-variant={variant}>
  {variant === "custom" && <CustomControls />}
  <section
    id="stopwatch"
    class="stopwatch-card"
    data-variant={variant}
    data-face={variant === "analog" ? "analog" : "digital"}
    aria-label="Chronomètre en ligne"
  >
    <div class="tool-topbar">
      <div class="tool-label">
        <Icon name="watch" size={18} />
        <h2>{label}</h2>
        <span class="tool-badge">GRATUIT</span>
      </div>
      <div class="tool-topbar-actions">
        <nav class="stopwatch-switcher" aria-label="Types de chronomètres">
          {stopwatchTypes.map((type) => (
            <a
              href={type.href}
              aria-current={type.variant === variant ? "page" : undefined}
            >
              {type.label}
            </a>
          ))}
        </nav>
        <button
          aria-label="Réglages du chronomètre"
          id="settings-open"
          class="quiet-button"
          aria-haspopup="dialog"
        >
          <Icon name="settings" size={17} />
          <span>Réglages</span>
        </button>
      </div>
    </div>
    <noscript>
      <p class="notice">
        Activez JavaScript pour utiliser le chronomètre. Les instructions
        restent accessibles ci-dessous.
      </p>
    </noscript>
    <div id="recovery" class="recovery notice" hidden>
      <div>
        <strong>Votre séance est enregistrée.</strong>
        <p id="recovery-detail">Une séance précédente peut être restaurée.</p>
      </div>
      <div class="recovery-actions">
        <button id="restore" class="small-button">
          Restaurer la séance
        </button>
        <button id="discard" class="quiet-button">
          Supprimer
        </button>
      </div>
    </div>
    <div class="timer-stage">
      <div class="session-status">
        <span id="run-dot" class="status-dot neutral"></span>
        <span id="run-status">Prêt à démarrer</span>
      </div>
      <h3 id="custom-session-title" class="custom-session-title" hidden></h3>
      <div class="analog-face" aria-hidden="true">
        <svg viewBox="0 0 240 240">
          <circle class="dial-rim" cx="120" cy="120" r="112" />
          {Array.from({ length: 60 }, (_, i) => (
            <line
              class:list={["dial-tick", { major: i % 5 === 0 }]}
              x1="120"
              y1="17"
              x2="120"
              y2={i % 5 === 0 ? "29" : "22"}
              transform={`rotate(${i * 6} 120 120)`}
            />
          ))}
          <text x="120" y="49">
            60
          </text>
          <text x="193" y="124">
            15
          </text>
          <text x="120" y="203">
            30
          </text>
          <text x="47" y="124">
            45
          </text>
          <line
            id="minute-hand"
            class="minute-hand"
            x1="120"
            y1="120"
            x2="120"
            y2="64"
          />
          <line
            id="second-hand"
            class="second-hand"
            x1="120"
            y1="136"
            x2="120"
            y2="35"
          />
          <circle class="dial-center" cx="120" cy="120" r="4" />
        </svg>
      </div>
      <div
        id="timer-display"
        class="timer-display"
        role="timer"
        aria-label="Temps écoulé"
        aria-live="off"
      >
        <span id="time-hours">00</span>
        <span class="time-colon">:</span>
        <span id="time-minutes">00</span>
        <span class="time-colon">:</span>
        <span id="time-seconds">00</span>
        <span id="time-fraction" class="time-fraction">
          .00
        </span>
      </div>
      <div class="time-labels" aria-hidden="true">
        <span>HEURES</span>
        <span>MINUTES</span>
        <span>SECONDES</span>
      </div>
      <div class="timer-actions">
        <button id="toggle" class="primary-button" disabled>
          <span id="play-icon">
            <Icon name="play" size={18} />
          </span>
          <span id="pause-icon" hidden>
            <Icon name="pause" size={18} />
          </span>
          <span id="toggle-label">Démarrer</span>
          <kbd aria-hidden="true">↵</kbd>
        </button>
        <button id="lap" class="secondary-button" disabled>
          <Icon name="flag" size={18} />
          <span>Tour</span>
          <kbd aria-hidden="true">L</kbd>
        </button>
        <button
          id="reset"
          class="reset-button icon-button"
          aria-label="Réinitialiser le chronomètre"
          title="Réinitialiser le chronomètre"
          disabled
        >
          <Icon name="reset" size={19} />
        </button>
      </div>
      <p id="current-lap" class="current-lap">
        Une activité. Un chrono. Votre rythme.
      </p>
    </div>
    <div class="tool-bottom">
      <span class="local-note">
        <Icon name="shield" size={14} />
        <span id="save-status">Votre séance reste sur cet appareil</span>
      </span>
      <button id="fullscreen" class="quiet-button">
        <Icon name="expand" size={15} />
        <span id="fullscreen-label">Plein écran</span>
        <kbd aria-hidden="true">F</kbd>
      </button>
    </div>
  </section>
  <div class="under-tool">
    <span>
      <Icon name="keyboard" size={15} /> <kbd>Espace</kbd>
      démarrer / pause <span class="shortcut-separator">·</span> <kbd>L</kbd>
      tour <span class="shortcut-separator">·</span> <kbd>R</kbd>
      réinitialiser
    </span>
    <span class="under-tool-right">
      Gardez le temps en vue, l’esprit libre.
    </span>
  </div>
  {variant === "minimal" && (
    <button
      id="minimal-records"
      class="quiet-button minimal-records"
      aria-expanded="false"
    >
      Afficher les tours
    </button>
  )}
  <div class="session-grid" hidden={variant === "minimal"}>
    <section class="laps-card panel" aria-labelledby="laps-title">
      <div class="panel-heading">
        <h2 id="laps-title">
          Temps par tour{" "}
          <span id="lap-count" class="count-badge">
            0
          </span>
        </h2>
        <div class="export-actions">
          <button
            id="copy"
            class="quiet-button icon-button"
            aria-label="Copier les temps par tour"
            title="Copier les temps par tour"
            disabled
          >
            <Icon name="copy" size={16} />
          </button>
          <button id="export" class="quiet-button" disabled>
            <Icon name="download" size={16} />
            <span>Exporter en CSV</span>
          </button>
        </div>
      </div>
      <div id="empty-laps" class="empty-laps">
        <span class="empty-icon">
          <Icon name="flag" size={23} />
        </span>
        <h3>Enregistrez votre premier tour.</h3>
        <p>
          Lancez le chronomètre et appuyez sur
          <kbd>L</kbd>
          pour enregistrer votre premier tour.
        </p>
      </div>
      <div id="lap-records" hidden>
        <div class="table-scroll">
          <table>
            <caption class="sr-only">
              Tours enregistrés, durées et temps cumulés
            </caption>
            <thead>
              <tr>
                <th scope="col">Tour / nom</th>
                <th scope="col">Durée du tour</th>
                <th scope="col">Temps cumulé</th>
              </tr>
            </thead>
            <tbody id="lap-body"></tbody>
          </table>
        </div>
        <div class="pagination">
          <span id="lap-page-status"></span>
          <button id="previous-laps" class="quiet-button">
            Précédent
          </button>
          <button id="next-laps" class="quiet-button">
            Suivant
          </button>
        </div>
      </div>
    </section>
    <section class="summary-card panel" aria-labelledby="summary-title">
      <div class="panel-heading">
        <h2 id="summary-title">Résumé de la séance</h2>
        <Icon name="chart" size={17} />
      </div>
      <dl>
        <div>
          <dt>
            <span class="stat-dot best"></span>
            Tour le plus rapide
          </dt>
          <dd id="fastest">—</dd>
        </div>
        <div>
          <dt>
            <span class="stat-dot slow"></span>
            Tour le plus lent
          </dt>
          <dd id="slowest">—</dd>
        </div>
        <div>
          <dt>
            <span class="stat-dot"></span>
            Durée moyenne
          </dt>
          <dd id="average">—</dd>
        </div>
      </dl>
      <div class="summary-foot">
        <span class="status-dot neutral"></span>
        <span id="summary-note">Suivez vos progrès, tour après tour.</span>
      </div>
    </section>
  </div>
</div>

<dialog id="settings-dialog" aria-labelledby="settings-title">
  <div class="dialog-heading">
    <div>
      <span class="eyebrow">VOTRE CHRONOMÈTRE</span>
      <h2 id="settings-title">Réglages du chronomètre</h2>
    </div>
    <button
      class="icon-button"
      data-close-dialog
      aria-label="Fermer les réglages"
    >
      <Icon name="close" />
    </button>
  </div>
  <div class="setting-row">
    <label for="theme-choice">
      Apparence
      <span>Un affichage agréable, de jour comme de nuit.</span>
    </label>
    <select id="theme-choice" name="theme">
      <option value="system">Système</option>
      <option value="light">Clair</option>
      <option value="dark">Sombre</option>
    </select>
  </div>
  <div class="setting-row">
    <label for="show-fractions">
      Afficher les centièmes
      <span>Affichez les fractions de seconde.</span>
    </label>
    <input id="show-fractions" type="checkbox" name="fractions" checked />
  </div>
  <div class="setting-row">
    <label for="enable-shortcuts">
      Raccourcis clavier
      <span>Espace / Entrée, L, R et F.</span>
    </label>
    <input id="enable-shortcuts" type="checkbox" name="shortcuts" checked />
  </div>
  <div class="setting-row">
    <label for="keep-awake">
      Garder l’écran allumé
      <span id="wake-description">
        Pendant le fonctionnement du chronomètre.
      </span>
    </label>
    <input id="keep-awake" type="checkbox" name="wake" />
  </div>
  <div class="settings-privacy">
    <Icon name="shield" size={19} />
    <p>
      Les données restent dans ce navigateur. Leur suppression efface les
      séances des chronomètres et minuteurs ainsi que vos préférences.
    </p>
  </div>
  <button id="clear-data" class="danger-button">
    Effacer les données locales…
  </button>
</dialog>
<dialog id="reset-dialog" aria-labelledby="reset-title">
  <div class="dialog-heading">
    <h2 id="reset-title">Commencer une nouvelle séance ?</h2>
    <button
      class="icon-button"
      data-close-dialog
      aria-label="Annuler la réinitialisation"
    >
      <Icon name="close" />
    </button>
  </div>
  <p id="reset-description" class="dialog-description">
    Le chronomètre et les tours seront effacés. Exportez d’abord les résultats
    que vous souhaitez conserver.
  </p>
  <div class="dialog-actions">
    <button class="secondary-button" data-close-dialog>
      Conserver la séance
    </button>
    <button id="confirm-reset" class="primary-button">
      Réinitialiser la séance
    </button>
  </div>
</dialog>
<div id="announcement" class="sr-only" role="status" aria-live="polite"></div>
<div id="toast" class="toast" role="status" hidden></div>
<script>
  import "../scripts/stopwatch";
</script>
