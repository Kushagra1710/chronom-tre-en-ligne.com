---
import Icon from "./Icon.astro";
import { tools } from "../lib/tools";
interface Props {
  compact?: boolean;
  filter?: "all" | "stopwatch" | "timer" | "focus";
  heading?: string;
}
const {
  compact = false,
  filter = "all",
  heading = "A clock for every moment.",
} = Astro.props;
---

<section
  class:list={["tool-directory", "wrap", { compact }]}
  aria-labelledby="directory-title"
>
  <div class="directory-heading">
    <div>
      <span class="eyebrow">FIND YOUR RHYTHM</span>
      <h2 id="directory-title">{heading}</h2>
    </div>
    {compact && (
      <a href="/tools/">
        Explore all tools <Icon name="arrow" size={16} />
      </a>
    )}
  </div>
  <div class="tool-card-grid">
    {tools
      .filter(
        (tool) =>
          filter === "all" ||
          (filter === "focus"
            ? ["/pomodoro/", "/interval-timer/"].includes(tool.href)
            : tool.type === filter),
      )
      .filter(
        (tool) =>
          !compact ||
          ["/timer/", "/analog-stopwatch/", "/custom-stopwatch/"].includes(
            tool.href,
          ),
      )
      .map((tool) => (
        <a class="tool-link-card" href={tool.href}>
          <div class="tool-card-top">
            <Icon name={tool.icon} size={18} />
            <span class="eyebrow">
              {tool.type === "timer" ? "COUNT DOWN" : "COUNT UP"}
            </span>
          </div>
          <div
            class:list={[
              "tool-preview",
              { "preview-custom": tool.label === "Custom" },
            ]}
            aria-hidden="true"
          >
            {tool.preview === "analog" ? (
              <span class="mini-dial">
                <i></i>
                <b></b>
              </span>
            ) : (
              tool.preview
            )}
          </div>
          <div class="tool-card-title">
            <h3>{tool.title}</h3>
            <Icon name="arrow" size={16} />
          </div>
          <p>{tool.description}</p>
        </a>
      ))}
  </div>
</section>
