---
import Icon from "./Icon.astro";
import type { TimerMode } from "../lib/tools";
interface Props {
  mode: TimerMode;
}
const { mode } = Astro.props;
const title = {
  countdown: "Minuteur en ligne",
  pomodoro: "Minuteur Pomodoro",
  interval: "Minuteur à intervalles",
}[mode];
---

<div class="wrap timer-workspace" data-timer-mode={mode}>
  <section class="timer-setup panel" aria-labelledby="setup-title">
    <div class="panel-heading">
      <h2 id="setup-title">
        <Icon name="settings" size={17} />{" "}
        {mode === "countdown" ? "Réglez la durée" : "Programmez votre séance"}
      </h2>
      <span class="settings-save-note" id="timer-storage-note">
        Enregistré sur cet appareil
      </span>
    </div>
    <form id="timer-form">
      <fieldset id="timer-fields">
        <legend class="sr-only">Configuration : {title}</legend>
        {mode === "countdown" ? (
          <>
            <div class="duration-inputs">
              <label for="duration-hours">
                Heures
                <input
                  type="number"
                  id="duration-hours"
                  name="hours"
                  min="0"
                  max="23"
                  step="1"
                  value="0"
                  inputmode="numeric"
                  required
                />
              </label>
              <span aria-hidden="true">:</span>
              <label for="duration-minutes">
                Minutes
                <input
                  type="number"
                  id="duration-minutes"
                  name="minutes"
                  min="0"
                  max="59"
                  step="1"
                  value="5"
                  inputmode="numeric"
                  required
                />
              </label>
              <span aria-hidden="true">:</span>
              <label for="duration-seconds">
                Secondes
                <input
                  type="number"
                  id="duration-seconds"
                  name="seconds"
                  min="0"
                  max="59"
                  step="1"
                  value="0"
                  inputmode="numeric"
                  required
                />
              </label>
            </div>
            <div class="preset-row">
              <span>Durées rapides</span>
              {[1, 5, 10, 15, 30, 60].map((minutes) => (
                <button type="button" data-preset={minutes}>
                  {minutes === 60 ? "1 heure" : `${minutes} min`}
                </button>
              ))}
            </div>
          </>
        ) : mode === "pomodoro" ? (
          <div class="routine-inputs">
            <label for="focus-minutes">
              Concentration · minutes
              <input
                id="focus-minutes"
                name="focus"
                type="number"
                min="1"
                max="180"
                step="1"
                value="25"
                required
              />
            </label>
            <label for="break-minutes">
              Pause courte · minutes
              <input
                id="break-minutes"
                name="break"
                type="number"
                min="1"
                max="60"
                step="1"
                value="5"
                required
              />
            </label>
            <label for="long-minutes">
              Pause longue · minutes
              <input
                id="long-minutes"
                name="long-break"
                type="number"
                min="1"
                max="120"
                step="1"
                value="15"
                required
              />
            </label>
            <label for="timer-rounds">
              Séances de concentration
              <input
                id="timer-rounds"
                name="rounds"
                type="number"
                min="1"
                max="12"
                step="1"
                value="4"
                required
              />
            </label>
          </div>
        ) : (
          <div class="routine-inputs">
            <label for="work-seconds">
              Effort · secondes
              <input
                id="work-seconds"
                name="work"
                type="number"
                min="1"
                max="3600"
                step="1"
                value="30"
                required
              />
            </label>
            <label for="rest-seconds">
              Repos · secondes
              <input
                id="rest-seconds"
                name="rest"
                type="number"
                min="0"
                max="3600"
                step="1"
                value="15"
                required
              />
            </label>
            <label for="timer-rounds">
              Cycles
              <input
                id="timer-rounds"
                name="rounds"
                type="number"
                min="1"
                max="100"
                step="1"
                value="8"
                required
              />
            </label>
          </div>
        )}
        <div class="setup-bottom">
          <p id="setup-hint">
            {mode === "countdown"
              ? "Choisissez le temps consacré à votre prochaine activité."
              : "Les phases s’enchaînent automatiquement. Réinitialisez pour modifier la séance."}
          </p>
          <div class="setup-actions">
            <button type="button" id="save-routine" class="quiet-button">
              Enregistrer le programme
            </button>
            <button type="submit" class="secondary-button">
              {mode === "countdown"
                ? "Appliquer la durée"
                : "Appliquer le programme"}
            </button>
          </div>
        </div>
      </fieldset>
      <p id="timer-error" class="form-error" role="alert" hidden></p>
    </form>
  </section>
  <section
    class="stopwatch-card countdown-card"
    id="countdown-card"
    aria-label={title}
  >
    <div class="tool-topbar">
      <div class="tool-label">
        <Icon name={mode === "interval" ? "reset" : "watch"} size={18} />
        <h2>{title}</h2>
        <span class="tool-badge">GRATUIT</span>
      </div>
      <span class="timer-phase-badge" id="phase-counter">
        {mode === "countdown" ? "VOTRE COMPTE À REBOURS" : "CYCLE 1"}
      </span>
    </div>
    <noscript>
      <p class="notice">Activez JavaScript pour utiliser ce minuteur.</p>
    </noscript>
    <div id="timer-recovery" class="recovery notice" hidden>
      <div>
        <strong>Votre minuteur est enregistré.</strong>
        <p>
          Restaurez la dernière séance, en incluant le temps d’absence, puis
          vérifiez-la en pause.
        </p>
      </div>
      <div class="recovery-actions">
        <button id="timer-restore" class="small-button">
          Restaurer le minuteur
        </button>
        <button id="timer-discard" class="quiet-button">
          Supprimer
        </button>
      </div>
    </div>
    <div class="timer-stage">
      <div class="session-status">
        <span id="countdown-dot" class="status-dot neutral"></span>
        <span id="countdown-state">Prêt à démarrer</span>
      </div>
      <p id="phase-label" class="phase-label">
        {mode === "countdown"
          ? "Votre compte à rebours"
          : mode === "pomodoro"
            ? "Concentration"
            : "Effort"}
      </p>
      <div
        class="countdown-display"
        role="timer"
        aria-live="off"
        aria-label="Temps restant"
      >
        <span id="countdown-hours">00</span>
        <span class="countdown-colon">:</span>
        <span id="countdown-minutes">
          {mode === "countdown" ? "05" : mode === "pomodoro" ? "25" : "00"}
        </span>
        <span class="countdown-colon">:</span>
        <span id="countdown-seconds">{mode === "interval" ? "30" : "00"}</span>
      </div>
      <div
        class="countdown-progress"
        role="progressbar"
        aria-label="Progression de la séance"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
      >
        <div id="countdown-progress-fill"></div>
      </div>
      <div class="timer-actions">
        <button id="countdown-toggle" class="primary-button" disabled>
          <Icon name="play" size={17} />
          <span id="countdown-toggle-label">Démarrer</span>
        </button>
        <button id="countdown-reset" class="secondary-button" disabled>
          <Icon name="reset" size={17} />
          Réinitialiser
        </button>
      </div>
      <p id="next-phase" class="current-lap">
        Votre temps, à votre rythme.
      </p>
    </div>
    <div class="tool-bottom">
      <label class="sound-label">
        <input id="timer-sound" name="sound" type="checkbox" checked />
        Son à la fin
      </label>
      <div class="timer-footer-actions">
        <button id="test-sound" class="quiet-button">
          Tester le son
        </button>
        <button id="timer-fullscreen" class="quiet-button">
          <Icon name="expand" size={15} />
          <span id="timer-fullscreen-label">Plein écran</span>
        </button>
      </div>
    </div>
  </section>
  <p class="timer-browser-note">
    Gardez cette page ouverte. Le son peut être retardé ou bloqué si l’appareil
    se met en veille ou si le navigateur suspend cet onglet.
  </p>
  {mode !== "countdown" && (
    <section class="routine-summary panel" aria-labelledby="routine-title">
      <div class="panel-heading">
        <h2 id="routine-title">Votre programme en un coup d’œil</h2>
        <span id="routine-total" class="settings-save-note"></span>
      </div>
      <ol id="routine-preview"></ol>
    </section>
  )}
  <p
    id="timer-message"
    class="timer-message"
    role="status"
    aria-live="polite"
  ></p>
</div>
<dialog id="timer-reset-dialog" aria-labelledby="timer-reset-title">
  <div class="dialog-heading">
    <h2 id="timer-reset-title">Réinitialiser cette séance ?</h2>
  </div>
  <p class="dialog-description">
    La progression sera effacée et le programme reprendra au début.
  </p>
  <div class="dialog-actions">
    <button id="timer-reset-cancel" class="secondary-button">
      Conserver la séance
    </button>
    <button id="timer-reset-confirm" class="primary-button">
      Réinitialiser le minuteur
    </button>
  </div>
</dialog>
<dialog id="routine-dialog" aria-labelledby="routine-dialog-title">
  <form id="routine-form" method="dialog">
    <div class="dialog-heading">
      <h2 id="routine-dialog-title">Enregistrer ce programme</h2>
    </div>
    <p class="dialog-description">
      Donnez un nom à ce programme. Il restera dans ce navigateur.
    </p>
    <label class="routine-name-label" for="routine-name">
      Nom du programme
      <input
        id="routine-name"
        name="name"
        maxlength="60"
        required
        placeholder="Ex. : Révisions de l’après-midi"
      />
    </label>
    <div class="dialog-actions">
      <button id="routine-cancel" type="button" class="secondary-button">
        Annuler
      </button>
      <button id="routine-save-confirm" value="default" class="primary-button">
        Enregistrer le programme
      </button>
    </div>
  </form>
</dialog>
<script>
  import "../scripts/countdown";
</script>
