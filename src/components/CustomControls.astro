---
import Icon from "./Icon.astro";
---

<section class="custom-controls panel" aria-labelledby="customize-title">
  <div class="panel-heading">
    <h2 id="customize-title">
      <Icon name="settings" size={17} />
      Personnalisez votre chrono
    </h2>
    <span class="settings-save-note" id="custom-save-note">
      Enregistré sur cet appareil
    </span>
  </div>
  <div class="custom-fields">
    <label class="wide-field" for="custom-title">
      Titre de la séance
      <input
        id="custom-title"
        name="session-title"
        type="text"
        maxlength="60"
        placeholder="Ex. : Révisions du matin…"
        autocomplete="off"
      />
    </label>
    <label for="custom-face">
      Affichage
      <select id="custom-face" name="clock-face">
        <option value="digital">Numérique</option>
        <option value="analog">Analogique</option>
      </select>
    </label>
    <label for="custom-palette">
      Couleur
      <select id="custom-palette" name="palette">
        <option value="ink">Encre</option>
        <option value="ocean">Bleu océan</option>
        <option value="forest">Vert forêt</option>
        <option value="plum">Prune</option>
      </select>
    </label>
    <label for="custom-font">
      Chiffres
      <select id="custom-font" name="font">
        <option value="mono">Chasse fixe</option>
        <option value="sans">Sans empattement</option>
      </select>
    </label>
    <label for="custom-size">
      Taille d’affichage
      <select id="custom-size" name="size">
        <option value="standard">Standard</option>
        <option value="large">Grand</option>
      </select>
    </label>
    <label for="custom-background">
      Fond
      <select id="custom-background" name="background">
        <option value="dots">Points discrets</option>
        <option value="plain">Uni</option>
        <option value="glow">Halo doux</option>
      </select>
    </label>
    <div class="custom-switches">
      <label class="custom-check">
        <input id="custom-fractions" name="fractions" type="checkbox" checked />{" "}
        Afficher les centièmes
      </label>
      <label class="custom-check">
        <input id="custom-laps" name="laps" type="checkbox" checked />
        Afficher les tours
      </label>
    </div>
  </div>
  <div class="custom-footer">
    <p>
      Le lien partage votre titre et votre apparence. Vos temps restent sur cet
      appareil.
    </p>
    <button id="share-custom" class="quiet-button">
      <Icon name="copy" size={15} />
      Copier le lien de personnalisation
    </button>
  </div>
</section>
