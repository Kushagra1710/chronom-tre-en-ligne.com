---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout title="Page introuvable | Chronomètre en ligne" noindex>
  <main id="main" class="wrap error-page">
    <section class="error-card" aria-labelledby="error-title">
      <div class="error-card-top">
        <a href="/" class="error-brand">
          <span class="error-brand-icon">
            <Icon name="watch" size={19} />
          </span>
          <span>
            Chronomètre <em>en ligne</em>
          </span>
        </a>
        <span class="error-status">404 · PAGE INTROUVABLE</span>
      </div>
      <div class="error-card-body">
        <div class="error-code" aria-hidden="true">
          404
        </div>
        <div class="error-copy">
          <span class="eyebrow">UNE PAGE À RETROUVER</span>
          <h1 id="error-title">Cette page est introuvable.</h1>
          <p>
            La page demandée n’existe pas ou a changé d’adresse. Choisissez un
            outil ci-dessous pour reprendre votre activité.
          </p>
          <div class="error-actions">
            <a href="/" class="primary-button">
              <Icon name="watch" size={17} /> Ouvrir le chronomètre
            </a>
            <a href="/outils/" class="secondary-button">
              Voir tous les outils <Icon name="arrow" size={16} />
            </a>
          </div>
        </div>
      </div>
      <p class="error-note">
        <Icon name="shield" size={15} /> Vos séances enregistrées restent dans
        ce navigateur.
      </p>
    </section>
  </main>
</Layout>
