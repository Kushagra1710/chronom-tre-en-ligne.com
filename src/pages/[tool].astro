---
import Layout from "../layouts/Layout.astro";
import StopwatchTool from "../components/StopwatchTool.astro";
import ToolNav from "../components/ToolNav.astro";
import TimerTool from "../components/TimerTool.astro";
import type { StopwatchVariant, TimerMode } from "../lib/tools";
export function getStaticPaths() {
  return [
    {
      slug: "chronometre-analogique",
      variant: "analog",
      title: "Chronomètre analogique en ligne gratuit",
      lead: "Chronomètre analogique.",
      accent: "Suivez les aiguilles.",
      description:
        "Un chronomètre analogique en ligne gratuit avec cadran à aiguilles, temps numérique, tours et mode plein écran.",
      help: "Lire votre chronomètre analogique",
      details:
        "La grande aiguille effectue un tour par minute et la petite un tour par heure. L’affichage numérique indique le temps total, y compris les heures. Lancez le chrono, enregistrez des tours et activez le plein écran pour suivre le cadran à distance.",
    },
    {
      slug: "chronometre-minimaliste",
      variant: "minimal",
      title: "Chronomètre en ligne minimaliste et plein écran",
      lead: "Chronomètre minimaliste.",
      accent: "L’essentiel à l’écran.",
      description:
        "Un chronomètre en ligne minimaliste avec de grands chiffres, un mode plein écran et des tours masqués à la demande. Gratuit et sans inscription.",
      help: "Un affichage épuré pour se concentrer",
      details:
        "Le chronomètre minimaliste garde les tours masqués jusqu’à ce que vous en ayez besoin. Cliquez sur Tour pour enregistrer un temps, puis sur Afficher les tours pour consulter ou exporter vos résultats. Le plein écran agrandit le chrono pour les révisions et les activités en classe.",
    },
    {
      slug: "chronometre-personnalise",
      variant: "custom",
      title: "Chronomètre en ligne aesthetic et plein écran personnalisé",
      lead: "Chronomètre en ligne aesthetic.",
      accent: "Votre style, votre rythme.",
      description:
        "Personnalisez votre chronomètre en ligne aesthetic : couleurs, police, fond et titre. Affichage numérique ou analogique et plein écran, gratuitement.",
      help: "Créer votre chronomètre en ligne plein écran aesthetic",
      details:
        "Choisissez un fond uni, des points discrets ou un halo doux. Ajustez les couleurs, la police et la taille des chiffres, puis ajoutez un titre. Vos changements s’appliquent immédiatement pendant la séance. Activez Plein écran pour obtenir un chrono aesthetic lisible en classe ou sur votre bureau. Le lien de personnalisation partage votre apparence et votre titre ; vos tours restent sur votre appareil.",
    },
    {
      slug: "minuteur",
      mode: "countdown",
      title: "Minuteur en ligne gratuit : 1 minute et durées au choix",
      lead: "Minuteur en ligne.",
      accent: "Choisissez votre durée.",
      description:
        "Lancez un minuteur en ligne gratuit de 1 minute, 5 minutes ou de la durée de votre choix, avec alerte sonore et plein écran.",
      heading: "Un compte à rebours pour votre prochaine activité",
      instructions:
        "Choisissez une durée rapide ou renseignez les heures, minutes et secondes. Cliquez sur Appliquer la durée puis Démarrer. Pour un compte à rebours de 1 minute, utilisez le bouton 1 min. Pause et Reprendre conservent le temps restant. À zéro, le minuteur affiche la fin et joue un son si cette option est activée.",
    },
    {
      slug: "pomodoro",
      mode: "pomodoro",
      title: "Minuteur Pomodoro gratuit pour la concentration",
      lead: "Minuteur Pomodoro.",
      accent: "Concentrez-vous, puis soufflez.",
      description:
        "Organisez vos révisions avec un minuteur Pomodoro gratuit en français. Réglez vos séances de concentration, pauses courtes et pauses longues.",
      heading: "Alterner concentration et pauses",
      instructions:
        "Choisissez la durée de concentration, des pauses et le nombre de séances. Les phases s’enchaînent automatiquement. Après chaque quatrième séance, une pause longue est proposée si une autre séance reste à effectuer. Le programme se termine après la dernière phase de concentration, sans pause supplémentaire.",
    },
    {
      slug: "minuteur-intervalle",
      mode: "interval",
      title: "Minuteur à intervalles gratuit : effort et repos",
      lead: "Minuteur à intervalles.",
      accent: "Effort, repos, recommencez.",
      description:
        "Programmez un minuteur à intervalles gratuit : durées d’effort et de repos, nombre de cycles, alerte sonore et plein écran pour vos entraînements.",
      heading: "Votre entraînement, cycle après cycle",
      instructions:
        "Réglez les durées d’effort et de repos en secondes, choisissez le nombre de cycles puis appliquez le programme. Les phases alternent automatiquement, sans repos après le dernier cycle. Réglez le repos à zéro pour des cycles continus. Vous pouvez mettre en pause ou réinitialiser la séance à tout moment.",
    },
  ].map((config) => ({ params: { tool: config.slug }, props: config }));
}
interface Props {
  variant?: StopwatchVariant;
  mode?: TimerMode;
  heading?: string;
  instructions?: string;
  title: string;
  lead: string;
  accent: string;
  description: string;
  help?: string;
  details?: string;
}
const {
  variant,
  mode,
  title,
  lead,
  accent,
  description,
  help,
  details,
  heading,
  instructions,
} = Astro.props;
---

<Layout title={`${title} | Chronomètre en ligne`} description={description}>
  <main id="main">
    {mode ? (
      <>
        <TimerTool mode={mode} />
        <ToolNav type="timer" />
        <section class="hero wrap">
          <span class="eyebrow">{title.toUpperCase()}</span>
          <h1>
            {lead} <span>{accent}</span>
          </h1>
          <p>{description}</p>
        </section>
        <section class="tool-help wrap">
          <h2>{heading}</h2>
          <p>{instructions}</p>
          <div class="help-grid">
            <article>
              <h3>Votre programme est enregistré</h3>
              <p>
                Votre programme et votre progression restent dans ce navigateur.
                Après un rechargement, choisissez Restaurer le minuteur. Si le
                minuteur était en cours, le temps d’absence est inclus, puis la
                séance se met en pause.
              </p>
            </article>
            <article>
              <h3>Une alerte sonore facultative</h3>
              <p>
                Utilisez Tester le son pour vérifier le volume avant de
                commencer, ou désactivez les alertes pour une séance
                silencieuse. Les sons peuvent être bloqués si le navigateur
                suspend l’onglet.
              </p>
            </article>
            <article>
              <h3>Comprendre le compte à rebours</h3>
              <p>
                Le compte à rebours utilise une échéance : un retard d’affichage
                ne prolonge pas une phase. Modifier l’horloge de l’appareil peut
                affecter le temps restant. Gardez le navigateur actif pour
                recevoir les alertes.
              </p>
            </article>
          </div>
        </section>{" "}
      </>
    ) : (
      <>
        <StopwatchTool variant={variant} />
        <section class="hero wrap variant-intro">
          <span class="eyebrow">{title.toUpperCase()}</span>
          <h1>
            {lead} <span>{accent}</span>
          </h1>
          <p>{description}</p>
        </section>
        <section class="tool-help wrap">
          <h2>{help}</h2>
          <p>{details}</p>
          <div class="help-grid">
            <article>
              <h3>Reprendre votre séance</h3>
              <p>
                Démarrez, mettez en pause et reprenez à votre rythme. Chaque
                type de chronomètre enregistre sa propre séance localement.
                Revenez au même outil pour la restaurer.
              </p>
            </article>
            <article>
              <h3>Enregistrer les tours</h3>
              <p>
                Chaque tour mesure le temps depuis le repère précédent. Le temps
                cumulé indique le total depuis le départ. Exportez vos résultats
                avant de réinitialiser la séance.
              </p>
            </article>
            <article>
              <h3>Connaître les limites</h3>
              <p>
                La veille de l’appareil peut affecter la mesure. La restauration
                d’une séance en cours utilise l’horloge de l’appareil, puis met
                le chronomètre en pause pour vérification. Aucun compte n’est
                nécessaire.
              </p>
            </article>
          </div>
        </section>{" "}
      </>
    )}
  </main>
</Layout>
