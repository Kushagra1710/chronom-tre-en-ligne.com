---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout title="Temporarily Unavailable | Wearlivo" noindex>
  <main id="main" class="wrap prose-page">
    <p class="error-brand"><Icon name="watch" size={19} /> Online Stopwatch by Wearlivo</p>
    <span class="eyebrow">503 · BACK SOON</span>
    <h1>We are briefly unavailable.</h1>
    <p>
      Online Stopwatch is temporarily unavailable while the service recovers or
      receives maintenance. Please check back shortly.
    </p>
    <p><a href="/">Try the stopwatch again →</a></p>
  </main>
</Layout>
