---
import Layout from "../layouts/Layout.astro";
import ToolMenu from "../components/ToolMenu.astro";
---

<Layout
  title="All Online Timers & Stopwatches | Online Stopwatch"
  description="Browse all Online Stopwatch tools. Open digital, analog, minimal, and custom stopwatches, countdown timers, Pomodoro, and interval timers on their own pages."
>
  <main id="main">
    <section class="hero wrap">
      <span class="eyebrow">ONE WEBSITE. EVERY KIND OF MOMENT.</span>
      <h1>
        A tool for your time.
        <br />
        <span>A space for your focus.</span>
      </h1>
      <p>Choose a category or go straight to your favorite tool.</p>
    </section>
    <ToolMenu />
  </main>
</Layout>
